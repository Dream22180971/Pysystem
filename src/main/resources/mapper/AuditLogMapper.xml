<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pharmacy.mapper.AuditLogMapper">

    <resultMap id="auditLogMap" type="com.pharmacy.bean.AuditLog">
        <id column="id" property="id"/>
        <result column="operator" property="operator"/>
        <result column="module" property="module"/>
        <result column="action" property="action"/>
        <result column="detail" property="detail"/>
        <result column="ip" property="ip"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectAllOrderByIdDesc" resultMap="auditLogMap">
        SELECT id, operator, module, action, detail, ip, created_at
        FROM audit_log
        ORDER BY id DESC
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(1) FROM audit_log
    </select>

    <select id="selectPageOrderByIdDesc" resultMap="auditLogMap">
        SELECT id, operator, module, action, detail, ip, created_at
        FROM audit_log
        ORDER BY
        <choose>
            <when test="sortField == 'createdAt'">
                created_at
            </when>
            <when test="sortField == 'id'">
                id
            </when>
            <otherwise>
                created_at
            </otherwise>
        </choose>
        <choose>
            <when test="sortOrder == 'desc'"> DESC</when>
            <otherwise> ASC</otherwise>
        </choose>
        , id
        <choose>
            <when test="sortOrder == 'desc'"> DESC</when>
            <otherwise> ASC</otherwise>
        </choose>
        LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>
