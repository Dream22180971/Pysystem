<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 药品分类Mapper映射文件 -->
<mapper namespace="com.pharmacy.mapper.CategoryMapper">
    <!-- 插入药品分类 -->
    <insert id="insert" parameterType="com.pharmacy.bean.Category">
        INSERT INTO category (category_name, status)
        VALUES (#{categoryName}, #{status})
    </insert>

    <!-- 更新药品分类 -->
    <update id="update" parameterType="com.pharmacy.bean.Category">
        UPDATE category
        SET category_name = #{categoryName},
            status = #{status}
        WHERE category_id = #{categoryId}
    </update>

    <!-- 删除药品分类 -->
    <delete id="delete" parameterType="java.lang.Integer">
        DELETE FROM category WHERE category_id = #{categoryId}
    </delete>

    <!-- 根据ID查询药品分类 -->
    <select id="selectById" parameterType="java.lang.Integer" resultType="com.pharmacy.bean.Category">
        SELECT * FROM category WHERE category_id = #{categoryId}
    </select>

    <!-- 查询所有药品分类 -->
    <select id="selectAll" resultType="com.pharmacy.bean.Category">
        SELECT * FROM category
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(1) FROM category
    </select>

    <select id="selectPage" resultType="com.pharmacy.bean.Category">
        SELECT * FROM category
        ORDER BY category_id
        <choose>
            <when test="sortDesc"> DESC</when>
            <otherwise> ASC</otherwise>
        </choose>
        LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>